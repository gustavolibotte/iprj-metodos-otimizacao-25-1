import numpy as np
import matplotlib.pyplot as plt
from matplotlib import cm
from mpl_toolkits.mplot3d.art3d import Poly3DCollection

class Problema:
    @staticmethod
    def f(x, dim=2):
        if dim == 2:
            return x[0]**2 + x[1]**2
        elif dim == 3:
            return x[0]**2 + x[1]**2 + x[2]**2
        else:
            raise ValueError("Dimensão não suportada. Use dim=2 ou dim=3.")

class NelderMead:
    def __init__(self, func, x0, alpha=1.0, gamma=2.0, rho=0.5, sigma=0.5, max_iter=200, tol=1e-6):
        self.func = func
        self.x0 = x0
        self.dim = len(x0)
        self.alpha = alpha
        self.gamma = gamma
        self.rho = rho
        self.sigma = sigma
        self.max_iter = max_iter
        self.tol = tol

    def minimizar(self):
        # Criação do simplex inicial
        simplex = [self.x0]
        for i in range(self.dim):
            x = np.copy(self.x0)
            x[i] += 0.05 if x[i] == 0 else 0.05 * x[i]
            simplex.append(x)
        history = [np.copy(simplex)]

        for _ in range(self.max_iter):
            simplex = sorted(simplex, key=self.func)
            best = simplex[0]
            worst = simplex[-1]
            second_worst = simplex[-2]

            # Cálculo do centroide dos melhores pontos
            centroid = np.mean(simplex[:-1], axis=0)

            # Reflexão
            xr = centroid + self.alpha * (centroid - worst)
            fxr = self.func(xr)

            if self.func(best) <= fxr < self.func(second_worst):
                simplex[-1] = xr
            elif fxr < self.func(best):
                # Expansão
                xe = centroid + self.gamma * (xr - centroid)
                if self.func(xe) < fxr:
                    simplex[-1] = xe
                else:
                    simplex[-1] = xr
            else:
                # Contração
                xc = centroid + self.rho * (worst - centroid)
                if self.func(xc) < self.func(worst):
                    simplex[-1] = xc
                else:
                    # Redução
                    for i in range(1, len(simplex)):
                        simplex[i] = best + self.sigma * (simplex[i] - best)

            history.append(np.copy(simplex))

            # Critério de convergência
            if np.std([self.func(p) for p in simplex]) < self.tol:
                break

        return simplex[0], history

class Visualizacao:
    @staticmethod
    def plot2d(history):
        # Geração da malha de contorno da função
        x = np.linspace(-2, 2, 400)
        y = np.linspace(-2, 2, 400)
        X, Y = np.meshgrid(x, y)
        Z = Problema.f([X, Y], dim=2)

        plt.figure(figsize=(10, 8))
        plt.contour(X, Y, Z, levels=50, cmap='viridis')

        # Colormap com maior contraste: HSV
        cmap = cm.get_cmap('hsv', len(history))

        # Desenha o simplex de cada iteração com cor bem distinta
        for i, simplex in enumerate(history):
            points = np.array(simplex)
            color = cmap(i)
            plt.plot(*zip(*points, points[0]), color=color, lw=2.5)  # Traço mais grosso

        # Marca o ponto mínimo final
        minimo = history[-1][0]
        plt.plot(minimo[0], minimo[1], 'ro', label='Mínimo encontrado')
        plt.title('Evolução do Simplex - f(x, y) = x² + y²')
        plt.xlabel('x')
        plt.ylabel('y')
        plt.legend()
        plt.grid(True)
        plt.show()

    @staticmethod
    def plot3d(history):
        fig = plt.figure(figsize=(12, 9))
        ax = fig.add_subplot(111, projection='3d')
        ax.set_title('Evolução do Simplex - f(x, y, z) = x² + y² + z²')

        # Colormap mais vívido
        cmap = cm.get_cmap('hsv', len(history))

        for i, simplex in enumerate(history):
            simplex = np.array(simplex)
            faces = [
                [simplex[0], simplex[1], simplex[2]],
                [simplex[0], simplex[1], simplex[3]],
                [simplex[0], simplex[2], simplex[3]],
                [simplex[1], simplex[2], simplex[3]]
            ]
            color = cmap(i)
            poly = Poly3DCollection(faces, alpha=0.3, edgecolor='k', linewidths=1)
            poly.set_facecolor(color)
            ax.add_collection3d(poly)

        # Marca o ponto mínimo final
        minimo = history[-1][0]
        ax.scatter(minimo[0], minimo[1], minimo[2], color='red', s=50, label='Mínimo encontrado')
        ax.set_xlabel('x')
        ax.set_ylabel('y')
        ax.set_zlabel('z')
        ax.set_xlim(-0.5, 1.25)
        ax.set_ylim(0, 2)
        ax.set_zlim(-2, 2)
        ax.legend()
        plt.show()

if __name__ == "__main__":
    # Execução 2D com função quadrática
    x_inicial_2d = np.array([1.5, -1.0])
    metodo2d = NelderMead(lambda x: Problema.f(x, dim=2), x_inicial_2d)
    minimo2d, historico2d = metodo2d.minimizar()
    print("Mínimo f2d encontrado em:", minimo2d)
    Visualizacao.plot2d(historico2d)

    # Execução 3D com função esférica
    x_inicial_3d = np.array([1.5, 1.0, -1.0])
    metodo3d = NelderMead(lambda x: Problema.f(x, dim=3), x_inicial_3d)
    minimo3d, historico3d = metodo3d.minimizar()
    print("Mínimo f3d encontrado em:", minimo3d)
    Visualizacao.plot3d(historico3d)
