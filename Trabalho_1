    # Execução 3D com função esférica
    x_inicial_3d = np.array([1.5, 1.0, -1.0])
    metodo3d = NelderMead(lambda x: Problema.f(x, dim=3), x_inicial_3d)
    minimo3d, historico3d = metodo3d.minimizar()
    print("Mínimo f3d encontrado em:", minimo3d)
    Visualizacao.plot3d(historico3d)

